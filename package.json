{
  "name": "office",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "prisma generate && tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 --import tsx test/*.test.ts && vitest run --config web/vite.config.ts",
    "test:e2e": "node --import tsx test/e2e/run.ts",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:sanitize": "node --import tsx test/e2e/sanitize-artifacts.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "privacy:anonymize": "node dist/src/jobs/anonymize-old-guests.js",
    "idempotency:cleanup": "node dist/src/jobs/cleanup-idempotency.js",
    "delivery:worker": "node dist/src/jobs/deliver-invitations.js",
    "auth:rollout": "tsx src/jobs/set-human-auth-rollout.ts",
    "auth:rotation:rehearse": "node scripts/rehearse-auth-key-rotation.mjs",
    "auth:rollout:evaluate": "tsx src/auth-rollout.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@prisma/client": "6.12.0",
    "fastify": "^5.5.0",
    "jose": "6.2.8",
    "openid-client": "6.8.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.35.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "prisma": "6.12.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
